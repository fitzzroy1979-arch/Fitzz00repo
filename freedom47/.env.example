# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1

# Optional: YouTube Data API v3 for channel/video metadata (title, description, upload date only)
YOUTUBE_API_KEY=

# Optional: Google Sheets/Docs deliverables (OAuth files live beside this)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Optional: email + Slack for webhook runs
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
SLACK_WEBHOOK_URL=

# Paper trading defaults
DEFAULT_STARTING_CASH=3000
DEFAULT_FEE_RATE=0.001
DEFAULT_SLIPPAGE_BPS=5

# Watchlist (comma-separated Yahoo tickers)
WATCHLIST=XRP-USD,XLM-USD,HBAR-USD,ZAMA-USD
